{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/fleet-mission-reports/index.html" },
    { "source": "/customer", "destination": "/fleet-mission-reports/index.html" },
    { "source": "/owner", "destination": "/vehicle_mission_report.html" },
    { "source": "/admin", "destination": "/vehicle_mission_report.html" },
    { "source": "/login", "destination": "/login.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
